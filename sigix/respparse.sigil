module sigix.respparse
  targets server
  trust none

use sigix.headers.Hdr;
use sigix.headers.clean_name;
use sigix.headers.clean_value;
use sigix.headers.hdr;
use sigix.text.find_from;
use sigix.text.hex_value;
use sigix.text.lower_bytes;
use sigix.text.parse_dec;
use sigix.text.sub;
use sigix.text.trim_ows;

// 上流の HTTP/1.1 応答の最小の読み取り（ADR 0056 決定 6）。`std.http` には応答の解釈が無いので sigix の中に置く
// （言語側に HttpResponseParser が入ったら置き換える）。上流には `Connection: close` で送るので、本文の終わりは
// Content-Length、チャンク、接続の切断のどれかで決まる。曖昧なもの（Content-Length と Transfer-Encoding の併記、
// 値の食い違う Content-Length、未対応の転送符号、1xx）は捨てて、呼び出し側が 502 にする。

pub struct Upstream {
  status: Int,
  headers: List<Hdr>,
  body: Bytes,
}

struct Head {
  status: Int,
  headers: List<Hdr>,
}

fn max_head() -> Int
  intent "応答の先頭（状態行とヘッダ）の上限（バイト）"
  requires none
  ensures none
  effects none
{
  return 65536;
}

fn max_headers() -> Int
  intent "応答のヘッダの数の上限"
  requires none
  ensures none
  effects none
{
  return 100;
}

fn crlf() -> Bytes
  intent "CR LF"
  requires none
  ensures none
  effects none
{
  let mut b = Bytes.new();
  b.push(13);
  b.push(10);
  return b;
}

fn crlf2() -> Bytes
  intent "CR LF CR LF"
  requires none
  ensures none
  effects none
{
  let mut b = crlf();
  b.extend(&crlf());
  return b;
}

// 先頭（状態行とヘッダ）の終わり（空行の次）の位置。まだ届いていなければ -1。from は探し始めの位置。
pub fn head_end(buf: &Bytes, from: Int) -> Int
  intent "バッファの from 番目以降に空行（CRLF CRLF）があれば、その次の位置を返す（無ければ -1）"
  requires none
  ensures none
  effects none
{
  let mut start = from - 3;
  if start < 0 {
    start = 0;
  }
  let at = find_from(&buf, &crlf2(), start);
  if at < 0 {
    return -1;
  }
  return at + 4;
}

pub fn head_limit() -> Int
  intent "先頭の上限（読み取りの途中で、これを超えても空行が無ければ打ち切る）"
  requires none
  ensures none
  effects none
{
  return max_head();
}

fn status_of(line: &Bytes) -> Int
  intent "状態行（HTTP/1.x SSS ...）から状態コードを読む。形が違う・200〜599 でないなら 0"
  requires none
  ensures none
  effects none
{
  if line.byte_len() < 12 {
    return 0;
  }
  let version = sub(&line, 0, 7);
  if version != "HTTP/1.".as_bytes() {
    return 0;
  }
  let minor = line.get(7).unwrap_or(0);
  if minor != 48 && minor != 49 {
    return 0;
  }
  if line.get(8).unwrap_or(0) != 32 {
    return 0;
  }
  if line.byte_len() > 12 && line.get(12).unwrap_or(0) != 32 {
    return 0;
  }
  match parse_dec(&sub(&line, 9, 12)) {
    None => {
      return 0;
    }
    Some(code) => {
      if code < 200 || code > 599 {
        return 0;
      }
      return code;
    }
  }
}

// ヘッダ 1 行（`名前: 値`）。折り返し（行頭の空白）・名前の不正・コロン無しは None。
fn header_line(line: &Bytes) -> Option<Hdr>
  intent "ヘッダ 1 行を読む（折り返し・名前の不正・コロン無しは None）"
  requires none
  ensures none
  effects none
{
  if line.byte_len() == 0 {
    return None;
  }
  let first = line.get(0).unwrap_or(0);
  if first == 32 || first == 9 {
    return None;
  }
  let mut colon = -1;
  let mut i = 0;
  while i < line.byte_len() && colon < 0 {
    if line.get(i).unwrap_or(0) == 58 {
      colon = i;
    }
    i = i + 1;
  }
  if colon <= 0 {
    return None;
  }
  let name = lower_bytes(&sub(&line, 0, colon)).to_string_utf8().unwrap_or("");
  if !clean_name(&name) {
    return None;
  }
  let value = trim_ows(&sub(&line, colon + 1, line.byte_len()));
  if !clean_value(&value) {
    return None;
  }
  return Some(hdr(&name, &value));
}

// 先頭を行ごとに読む。戻り値は (状態コード, ヘッダの一覧)。不正なら状態コードが 0。
fn parse_head(head: &Bytes) -> Head
  intent "先頭（状態行とヘッダ。末尾の空行は含まない）を読む。不正なら状態コード 0"
  requires none
  ensures none
  effects none
{
  let mut headers = List.new();
  let mut status = 0;
  let mut start = 0;
  let mut first = true;
  let mut bad = false;
  while start <= head.byte_len() && !bad {
    let mut end = find_from(&head, &crlf(), start);
    let last = end < 0;
    if last {
      end = head.byte_len();
    }
    let line = sub(&head, start, end);
    if first {
      status = status_of(&line);
      if status == 0 {
        bad = true;
      }
      first = false;
    } else {
      match header_line(&line) {
        None => {
          bad = true;
        }
        Some(h) => {
          if headers.len() >= max_headers() {
            bad = true;
          } else {
            headers.push(h);
          }
        }
      }
    }
    if last {
      start = head.byte_len() + 1;
    } else {
      start = end + 2;
    }
  }
  if bad {
    return Head { status: 0, headers: List.new() };
  }
  return Head { status: status, headers: headers };
}

fn values_of(headers: &List<Hdr>, lname: &String) -> List<Bytes>
  intent "同じ名前のヘッダの値の一覧"
  requires none
  ensures none
  effects none
{
  let mut out = List.new();
  let mut i = 0;
  while i < headers.len() {
    match headers.get(i) {
      None => {}
      Some(h) => {
        if h.name == lname {
          out.push(h.value.clone());
        }
      }
    }
    i = i + 1;
  }
  return out;
}

// Content-Length: 無ければ -1、不正（数字以外・値の食い違い）なら -2。
fn content_length(headers: &List<Hdr>) -> Int
  intent "Content-Length を読む（無ければ -1、不正・食い違いなら -2）"
  requires none
  ensures none
  effects none
{
  let vs = values_of(&headers, &"content-length");
  if vs.len() == 0 {
    return -1;
  }
  let mut n = -1;
  let mut i = 0;
  while i < vs.len() {
    match vs.get(i) {
      None => {}
      Some(v) => {
        match parse_dec(&v) {
          None => {
            return -2;
          }
          Some(x) => {
            if n >= 0 && x != n {
              return -2;
            }
            n = x;
          }
        }
      }
    }
    i = i + 1;
  }
  return n;
}

// チャンクの本文を復号する。形が違う・途中で切れている・上限を超える場合は None。
fn decode_chunks(data: &Bytes, max_body: Int) -> Option<Bytes>
  intent "チャンク形式の本文を復号する（形の誤り・途中切れ・上限超過は None。トレーラーは読み捨てる）"
  requires 0 <= max_body
  ensures none
  effects none
{
  let mut out = Bytes.new();
  let mut pos = 0;
  while true {
    let eol = find_from(&data, &crlf(), pos);
    if eol < 0 {
      return None;
    }
    let mut size = 0;
    let mut digits = 0;
    let mut i = pos;
    let mut in_ext = false;
    while i < eol {
      let c = data.get(i).unwrap_or(0);
      if in_ext {
        // チャンク拡張は読み捨てる
      } else if c == 59 {
        in_ext = true;
      } else {
        let v = hex_value(c);
        if v < 0 || digits >= 12 {
          return None;
        }
        size = size * 16 + v;
        digits = digits + 1;
      }
      i = i + 1;
    }
    if digits == 0 {
      return None;
    }
    if size == 0 {
      // 最後のチャンク。トレーラーと空行が揃うまでは受け取れたことにしない。
      let after = eol + 2;
      if after + 2 <= data.byte_len() && sub(&data, after, after + 2) == crlf() {
        return Some(out);
      }
      if find_from(&data, &crlf2(), eol) >= 0 {
        return Some(out);
      }
      return None;
    }
    if out.byte_len() + size > max_body {
      return None;
    }
    let body_start = eol + 2;
    if body_start + size + 2 > data.byte_len() {
      return None;
    }
    if sub(&data, body_start + size, body_start + size + 2) != crlf() {
      return None;
    }
    out.extend(&sub(&data, body_start, body_start + size));
    pos = body_start + size + 2;
  }
  return None;
}

// 応答全体（先頭と本文）を読む。no_body は HEAD の応答（本文を持たない）。
pub fn parse_response(buf: &Bytes, no_body: Bool, max_body: Int) -> Option<Upstream>
  intent "上流の応答（先頭と本文）を読む。曖昧・不正・上限超過・途中切れは None"
  requires 0 <= max_body
  ensures none
  effects none
{
  let he = head_end(&buf, 0);
  if he < 0 || he > max_head() {
    return None;
  }
  let head = sub(&buf, 0, he - 4);
  let parsed = parse_head(&head);
  let status = parsed.status;
  if status == 0 {
    return None;
  }
  let headers = parsed.headers;
  let data = sub(&buf, he, buf.byte_len());
  let tes = values_of(&headers, &"transfer-encoding");
  let cl = content_length(&headers);
  if cl == -2 {
    return None;
  }
  if tes.len() > 0 && cl >= 0 {
    return None;
  }
  let bodyless = no_body || status == 204 || status == 304;
  if bodyless {
    return Some(Upstream { status: status, headers: headers, body: Bytes.new() });
  }
  if tes.len() > 0 {
    if tes.len() != 1 {
      return None;
    }
    let mut te = Bytes.new();
    match tes.get(0) {
      None => {}
      Some(v) => {
        te = lower_bytes(&trim_ows(&v));
      }
    }
    if te != "chunked".as_bytes() {
      return None;
    }
    return match decode_chunks(&data, max_body) {
      None => None,
      Some(body) => Some(Upstream { status: status, headers: headers, body: body }),
    };
  }
  if cl >= 0 {
    if cl > max_body || data.byte_len() < cl {
      return None;
    }
    return Some(Upstream { status: status, headers: headers, body: sub(&data, 0, cl) });
  }
  if data.byte_len() > max_body {
    return None;
  }
  return Some(Upstream { status: status, headers: headers, body: data });
}

// 読み取りを早く打ち切るための目安: Content-Length で全体の長さが決まっていればその長さ、そうでなければ -1。
pub fn expected_total(buf: &Bytes, no_body: Bool) -> Int
  intent "先頭が届いていて Content-Length で全体の長さが決まるなら、その長さ（先頭を含む）を返す（それ以外は -1）"
  requires none
  ensures none
  effects none
{
  let he = head_end(&buf, 0);
  if he < 0 || he > max_head() {
    return -1;
  }
  let parsed = parse_head(&sub(&buf, 0, he - 4));
  if parsed.status == 0 {
    return -1;
  }
  if no_body || parsed.status == 204 || parsed.status == 304 {
    return he;
  }
  let cl = content_length(&parsed.headers);
  if cl < 0 {
    return -1;
  }
  return he + cl;
}
