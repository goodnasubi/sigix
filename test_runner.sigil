module test_runner
  targets server
  trust none

use tests.test_config.run_config_tests;
use tests.test_mime.run_mime_tests;
use tests.test_proxy.run_allowlist_tests;
use tests.test_proxy.run_conditional_tests;
use tests.test_proxy.run_forward_tests;
use tests.test_proxy.run_header_tests;
use tests.test_proxy.run_response_tests;
use tests.test_proxy.run_routes_tests;
use tests.test_serve.run_log_tests;
use tests.test_serve.run_serve_tests;
use tests.test_target.run_target_tests;

pub fn main() -> Int
  intent "すべての単体テストを実行し、全合格なら 0、不合格があれば失敗した群の番号を返す"
  requires none
  ensures none
  effects clock, console, fs, task.share, task.suspend
{
  if !run_target_tests() {
    return 1;
  }
  if !run_mime_tests() {
    return 2;
  }
  if !run_config_tests() {
    return 3;
  }
  if !run_serve_tests() {
    return 4;
  }
  if !run_log_tests() {
    return 5;
  }
  if !run_header_tests() {
    return 6;
  }
  if !run_response_tests() {
    return 7;
  }
  if !run_conditional_tests() {
    return 8;
  }
  if !run_routes_tests() {
    return 9;
  }
  if !run_forward_tests() {
    return 10;
  }
  if !run_allowlist_tests() {
    return 11;
  }
  return 0;
}
