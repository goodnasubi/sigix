module tests.test_cache
  targets server
  trust none

use sigix.cache.deserialize_cached_response;
use sigix.cache.encode_stash_delete;
use sigix.cache.encode_stash_get;
use sigix.cache.encode_stash_put;
use sigix.cache.extract_age;
use sigix.cache.is_unsafe_method;
use sigix.cache.make_cache_key;
use sigix.cache.parse_request_cache_control;
use sigix.cache.parse_stash_response;
use sigix.cache.request_cache_key;
use sigix.cache.request_cacheable;
use sigix.cache.response_cacheable;
use sigix.cache.response_freshness_lifetime;
use sigix.cache.serialize_cached_response;
use sigix.headers.hdr;
use sigix.routes.parse_settings;
use tests.support.body_text;
use tests.support.fail;
use tests.support.header_of;
use tests.support.make_raw_request;
use tests.support.make_request;

fn check_key(prefix: &String, host: &String, path: &String, query: &String) -> String
  intent "make_cache_key の結果を文字列で返す（None なら空文字列）"
  requires none
  ensures none
  effects none
{
  let k = make_cache_key(&prefix, &host, &path.as_bytes(), &query.as_bytes());
  return match k {
    Some(b) => b.to_string_utf8().unwrap_or(""),
    None => "",
  };
}

pub fn run_cache_key_tests() -> Bool
  intent "キャッシュキー生成規則と上限のテスト"
  requires none
  ensures none
  effects console
{
  let k1 = check_key(&"/api/", &"api.example.com", &"/api/items", &"");
  if k1 != "/api/:api.example.com:/api/items" {
    return fail(&"cache_key: クエリなしの形式");
  }

  let k2 = check_key(&"/api/", &"api.example.com", &"/api/items", &"page=1&sort=asc");
  if k2 != "/api/:api.example.com:/api/items?page=1&sort=asc" {
    return fail(&"cache_key: クエリありの形式");
  }

  // ポート番号付きホスト（小文字化されポートも保持）
  let req_opt = make_raw_request(&"GET /api/v1/test HTTP/1.1\r\nHost: API.Example.COM:8443", &Bytes.new());
  match req_opt {
    None => {
      return fail(&"cache_key: 要求作成失敗");
    }
    Some(req) => {
      let rk = request_cache_key(&"/api/v1/", &req);
      let s = match rk {
        Some(b) => b.to_string_utf8().unwrap_or(""),
        None => "",
      };
      if s != "/api/v1/:api.example.com:8443:/api/v1/test" {
        return fail(&"cache_key: ホストの小文字化");
      }
    }
  }

  // 512 バイトちょうどのキーは成功
  let mut long_p = Bytes.new();
  while long_p.byte_len() < 480 {
    long_p.push(97);
  }
  let k_fit = make_cache_key(&"/", &"h", &long_p, &Bytes.new());
  if k_fit.is_none() {
    return fail(&"cache_key: 512 バイト以下は許可");
  }

  // 513 バイトを超えるキーは None
  let mut too_long = Bytes.new();
  while too_long.byte_len() < 520 {
    too_long.push(98);
  }
  let k_too_long = make_cache_key(&"/", &"h", &too_long, &Bytes.new());
  if k_too_long.is_some() {
    return fail(&"cache_key: 512 バイト超は拒否");
  }

  return true;
}

pub fn run_cache_request_tests() -> Bool
  intent "要求のキャッシュ可否判定テスト"
  requires none
  ensures none
  effects console
{
  // 正常な GET 要求
  let r_get = make_request(&"GET", &"/data");
  match r_get {
    None => {
      return fail(&"req_cacheable: GET 要求作成失敗");
    }
    Some(req) => {
      if !request_cacheable(&req) {
        return fail(&"req_cacheable: プレーンな GET はキャッシュ可");
      }
    }
  }

  // POST 要求は不可
  let r_post = make_request(&"POST", &"/data");
  match r_post {
    None => {
      return fail(&"req_cacheable: POST 要求作成失敗");
    }
    Some(req) => {
      if request_cacheable(&req) {
        return fail(&"req_cacheable: POST はキャッシュ不可");
      }
    }
  }

  // Authorization 付き GET は不可
  let r_auth = make_raw_request(&"GET /data HTTP/1.1\r\nHost: example.com\r\nAuthorization: Bearer xyz", &Bytes.new());
  match r_auth {
    None => {
      return fail(&"req_cacheable: Auth 要求作成失敗");
    }
    Some(req) => {
      if request_cacheable(&req) {
        return fail(&"req_cacheable: Authorization 付きはキャッシュ不可");
      }
    }
  }

  // Cookie 付き GET は不可
  let r_cookie = make_raw_request(&"GET /data HTTP/1.1\r\nHost: example.com\r\nCookie: session=123", &Bytes.new());
  match r_cookie {
    None => {
      return fail(&"req_cacheable: Cookie 要求作成失敗");
    }
    Some(req) => {
      if request_cacheable(&req) {
        return fail(&"req_cacheable: Cookie 付きはキャッシュ不可");
      }
    }
  }

  // Cache-Control: no-store は不可
  let r_nostore = make_raw_request(&"GET /data HTTP/1.1\r\nHost: example.com\r\nCache-Control: no-store", &Bytes.new());
  match r_nostore {
    None => {
      return fail(&"req_cacheable: no-store 要求作成失敗");
    }
    Some(req) => {
      if request_cacheable(&req) {
        return fail(&"req_cacheable: Cache-Control: no-store はキャッシュ不可");
      }
    }
  }

  // Cache-Control: no-cache は不可
  let r_nocache = make_raw_request(&"GET /data HTTP/1.1\r\nHost: example.com\r\nCache-Control: max-age=100, no-cache", &Bytes.new());
  match r_nocache {
    None => {
      return fail(&"req_cacheable: no-cache 要求作成失敗");
    }
    Some(req) => {
      if request_cacheable(&req) {
        return fail(&"req_cacheable: Cache-Control: no-cache はキャッシュ不可");
      }
    }
  }

  // P1: 引数付き Cache-Control: no-cache="x-header" は不可
  let r_nocache_arg = make_raw_request(&"GET /data HTTP/1.1\r\nHost: example.com\r\nCache-Control: no-cache=\"x-header\"", &Bytes.new());
  match r_nocache_arg {
    None => {
      return fail(&"req_cacheable: no-cache 引数付き要求作成失敗");
    }
    Some(req) => {
      if request_cacheable(&req) {
        return fail(&"req_cacheable: Cache-Control: no-cache=\"x-header\" はキャッシュ不可");
      }
    }
  }

  // P2: 要求の Cache-Control ディレクティブ（max-age, min-fresh）の解釈
  let r_policy = make_raw_request(&"GET /data HTTP/1.1\r\nHost: example.com\r\nCache-Control: max-age=60, min-fresh=15", &Bytes.new());
  match r_policy {
    None => {
      return fail(&"req_policy: 要求作成失敗");
    }
    Some(req) => {
      let pol = parse_request_cache_control(&req);
      if pol.max_age != Some(60) {
        return fail(&"req_policy: max-age 解釈不一致 (期待 60)");
      }
      if pol.min_fresh != Some(15) {
        return fail(&"req_policy: min-fresh 解釈不一致 (期待 15)");
      }
      if pol.no_store || pol.no_cache {
        return fail(&"req_policy: no-store / no-cache が誤検知");
      }
    }
  }

  // P2: max-age=0 の解釈
  let r_zero = make_raw_request(&"GET /data HTTP/1.1\r\nHost: example.com\r\nCache-Control: max-age=0", &Bytes.new());
  match r_zero {
    None => {
      return fail(&"req_policy: max-age=0 要求作成失敗");
    }
    Some(req) => {
      let pol_zero = parse_request_cache_control(&req);
      if pol_zero.max_age != Some(0) {
        return fail(&"req_policy: max-age=0 解釈不一致");
      }
    }
  }

  // P2: 非安全メソッド判定（is_unsafe_method）
  if is_unsafe_method(&"GET") || is_unsafe_method(&"HEAD") || is_unsafe_method(&"OPTIONS") || is_unsafe_method(&"TRACE") {
    return fail(&"is_unsafe_method: 安全メソッド（GET/HEAD/OPTIONS/TRACE）は false");
  }
  if !is_unsafe_method(&"POST") || !is_unsafe_method(&"PUT") || !is_unsafe_method(&"DELETE") || !is_unsafe_method(&"PATCH") {
    return fail(&"is_unsafe_method: 変更メソッド（POST/PUT/DELETE/PATCH）は true");
  }

  return true;
}

pub fn run_cache_response_tests() -> Bool
  intent "応答のキャッシュ可否と TTL 決定のテスト（P1 引数付きディレクティブ・P2 Age による残余鮮度計算を含む）"
  requires none
  ensures none
  effects console
{
  // 200 OK + max-age=120
  let mut h1 = List.new();
  h1.push(hdr(&"cache-control", &"max-age=120".as_bytes()));
  h1.push(hdr(&"content-type", &"text/plain".as_bytes()));
  let ttl1 = response_cacheable(200, &h1, 60);
  if ttl1 != Some(120) {
    return fail(&"resp_cacheable: max-age=120 の TTL");
  }

  // 200 OK + public, s-maxage=300, max-age=120 -> s-maxage が優先
  let mut h2 = List.new();
  h2.push(hdr(&"cache-control", &"public, max-age=120, s-maxage=300".as_bytes()));
  let ttl2 = response_cacheable(200, &h2, 60);
  if ttl2 != Some(300) {
    return fail(&"resp_cacheable: s-maxage 優先");
  }

  // 200 OK + public (max-age なし) -> default_ttl が適用
  let mut h3 = List.new();
  h3.push(hdr(&"cache-control", &"public".as_bytes()));
  let ttl3 = response_cacheable(200, &h3, 60);
  if ttl3 != Some(60) {
    return fail(&"resp_cacheable: public 単体でデフォルト TTL");
  }

  // 404 Not Found は不可
  let ttl4 = response_cacheable(404, &h1, 60);
  if ttl4 != None {
    return fail(&"resp_cacheable: 200 以外はキャッシュ不可");
  }

  // Set-Cookie ありは不可
  let mut h_cookie = List.new();
  h_cookie.push(hdr(&"cache-control", &"public, max-age=60".as_bytes()));
  h_cookie.push(hdr(&"set-cookie", &"sid=123".as_bytes()));
  if response_cacheable(200, &h_cookie, 60) != None {
    return fail(&"resp_cacheable: Set-Cookie ありはキャッシュ不可");
  }

  // Vary ありは不可
  let mut h_vary = List.new();
  h_vary.push(hdr(&"cache-control", &"public, max-age=60".as_bytes()));
  h_vary.push(hdr(&"vary", &"Accept-Encoding".as_bytes()));
  if response_cacheable(200, &h_vary, 60) != None {
    return fail(&"resp_cacheable: Vary ありはキャッシュ不可");
  }

  // private は不可
  let mut h_priv = List.new();
  h_priv.push(hdr(&"cache-control", &"private, max-age=60".as_bytes()));
  if response_cacheable(200, &h_priv, 60) != None {
    return fail(&"resp_cacheable: private はキャッシュ不可");
  }

  // P1: 引数付き private="x-user-info" は不可
  let mut h_priv_qual = List.new();
  h_priv_qual.push(hdr(&"cache-control", &"private=\"x-user-info\", max-age=60".as_bytes()));
  if response_cacheable(200, &h_priv_qual, 60) != None {
    return fail(&"resp_cacheable: private=\"x-user-info\" はキャッシュ不可（P1）");
  }

  // P1: 引用符なし引数付き private=field は不可
  let mut h_priv_bare = List.new();
  h_priv_bare.push(hdr(&"cache-control", &"private=field, max-age=60".as_bytes()));
  if response_cacheable(200, &h_priv_bare, 60) != None {
    return fail(&"resp_cacheable: private=field はキャッシュ不可（P1）");
  }

  // no-store は不可
  let mut h_ns = List.new();
  h_ns.push(hdr(&"cache-control", &"public, no-store, max-age=60".as_bytes()));
  if response_cacheable(200, &h_ns, 60) != None {
    return fail(&"resp_cacheable: no-store はキャッシュ不可");
  }

  // no-cache は不可
  let mut h_nc = List.new();
  h_nc.push(hdr(&"cache-control", &"public, no-cache, max-age=60".as_bytes()));
  if response_cacheable(200, &h_nc, 60) != None {
    return fail(&"resp_cacheable: no-cache はキャッシュ不可");
  }

  // P1: 引数付き no-cache="x-user-info" は不可
  let mut h_nc_qual = List.new();
  h_nc_qual.push(hdr(&"cache-control", &"no-cache=\"x-user-info\", max-age=60".as_bytes()));
  if response_cacheable(200, &h_nc_qual, 60) != None {
    return fail(&"resp_cacheable: no-cache=\"x-user-info\" はキャッシュ不可（P1）");
  }

  // P1: 引用符なし引数付き no-cache=field は不可
  let mut h_nc_bare = List.new();
  h_nc_bare.push(hdr(&"cache-control", &"no-cache=field, max-age=60".as_bytes()));
  if response_cacheable(200, &h_nc_bare, 60) != None {
    return fail(&"resp_cacheable: no-cache=field はキャッシュ不可（P1）");
  }

  // Cache-Control なしは不可
  let mut h_none = List.new();
  h_none.push(hdr(&"content-type", &"text/plain".as_bytes()));
  if response_cacheable(200, &h_none, 60) != None {
    return fail(&"resp_cacheable: Cache-Control なしはキャッシュ不可");
  }

  // s-maxage=0 は TTL <= 0 のため不可
  let mut h_zero = List.new();
  h_zero.push(hdr(&"cache-control", &"public, s-maxage=0".as_bytes()));
  if response_cacheable(200, &h_zero, 60) != None {
    return fail(&"resp_cacheable: TTL <= 0 はキャッシュ不可");
  }

  // P2: Age: 59 と max-age=60 -> 残り TTL = 1 秒
  let mut h_age59 = List.new();
  h_age59.push(hdr(&"cache-control", &"max-age=60".as_bytes()));
  h_age59.push(hdr(&"age", &"59".as_bytes()));
  let ttl_age59 = response_cacheable(200, &h_age59, 60);
  if ttl_age59 != Some(1) {
    return fail(&"resp_cacheable: Age: 59 と max-age=60 で残り TTL=1（P2）");
  }

  // P2: Age: 120 と max-age=60（stale）-> キャッシュ不可（None）
  let mut h_stale = List.new();
  h_stale.push(hdr(&"cache-control", &"max-age=60".as_bytes()));
  h_stale.push(hdr(&"age", &"120".as_bytes()));
  if response_cacheable(200, &h_stale, 60) != None {
    return fail(&"resp_cacheable: stale 応答 (Age > max-age) はキャッシュ不可（P2）");
  }

  // P2: Age: 60 と max-age=60（使い切り）-> キャッシュ不可（None）
  let mut h_exact = List.new();
  h_exact.push(hdr(&"cache-control", &"max-age=60".as_bytes()));
  h_exact.push(hdr(&"age", &"60".as_bytes()));
  if response_cacheable(200, &h_exact, 60) != None {
    return fail(&"resp_cacheable: 鮮度期間終了 (Age == max-age) はキャッシュ不可（P2）");
  }

  // P2: Age: 10 と s-maxage=100 -> 残り TTL = 90
  let mut h_smaxage_age = List.new();
  h_smaxage_age.push(hdr(&"cache-control", &"s-maxage=100, max-age=60".as_bytes()));
  h_smaxage_age.push(hdr(&"age", &"10".as_bytes()));
  if response_cacheable(200, &h_smaxage_age, 60) != Some(90) {
    return fail(&"resp_cacheable: Age を考慮した s-maxage 残余鮮度（P2）");
  }

  // P2: extract_age 単体確認
  let mut h_age_trim = List.new();
  h_age_trim.push(hdr(&"age", &"  42  ".as_bytes()));
  if extract_age(&h_age_trim) != 42 {
    return fail(&"extract_age: トリム付き Age 解釈（P2）");
  }
  if extract_age(&h1) != 0 {
    return fail(&"extract_age: Age ヘッダなしは 0（P2）");
  }

  // P2: response_freshness_lifetime 単体確認
  if response_freshness_lifetime(&h_smaxage_age, 60) != 100 {
    return fail(&"response_freshness_lifetime: s-maxage 優先鮮度期間");
  }
  if response_freshness_lifetime(&h1, 60) != 120 {
    return fail(&"response_freshness_lifetime: max-age 鮮度期間");
  }
  if response_freshness_lifetime(&h3, 60) != 60 {
    return fail(&"response_freshness_lifetime: public デフォルト鮮度期間");
  }
  if response_freshness_lifetime(&h_priv, 60) != -1 {
    return fail(&"response_freshness_lifetime: private は -1");
  }

  return true;
}

pub fn run_cache_codec_tests() -> Bool
  intent "HTTP 応答のバイナリ直列化・復元および Age ヘッダ更新のテスト"
  requires none
  ensures none
  effects console
{
  let mut hs = List.new();
  hs.push(hdr(&"content-type", &"text/html; charset=utf-8".as_bytes()));
  hs.push(hdr(&"cache-control", &"public, max-age=300".as_bytes()));
  let body = "<h1>Cached Payload</h1>".as_bytes();

  // cached_at = 1000, initial_age = 10 で直列化
  let encoded = serialize_cached_response(200, &hs, &body, 1000, 10);
  match encoded {
    None => {
      return fail(&"codec: 直列化失敗");
    }
    Some(bytes) => {
      // now = 1005 (5秒経過): Age = 10 + 5 = 15
      let decoded = deserialize_cached_response(&bytes, 1005);
      match decoded {
        None => {
          return fail(&"codec: 復元失敗");
        }
        Some(res) => {
          if res.status() != 200 {
            return fail(&"codec: 復元状態コード不一致");
          }
          if body_text(&res) != "<h1>Cached Payload</h1>" {
            return fail(&"codec: 復元本文不一致");
          }
          if header_of(&res, &"content-type") != "text/html; charset=utf-8" {
            return fail(&"codec: 復元ヘッダ不一致");
          }
          if header_of(&res, &"age") != "15" {
            return fail(&"codec: 経過時間反映の Age 不一致 (期待 15)");
          }
        }
      }

      // now = 1000 (0秒経過): Age = 10 + 0 = 10
      let decoded_immediate = deserialize_cached_response(&bytes, 1000);
      match decoded_immediate {
        None => {
          return fail(&"codec: 即時復元失敗");
        }
        Some(res0) => {
          if header_of(&res0, &"age") != "10" {
            return fail(&"codec: 即時復元の Age 不一致 (期待 10)");
          }
        }
      }
    }
  }

  // 元から Age ヘッダを持つ応答を直列化しても、復元時に古い値が残らず単一の更新 Age になること
  let mut hs_with_age = List.new();
  hs_with_age.push(hdr(&"content-type", &"text/plain".as_bytes()));
  hs_with_age.push(hdr(&"age", &"10".as_bytes()));
  let enc_age = serialize_cached_response(200, &hs_with_age, &"hello".as_bytes(), 1000, 10);
  match enc_age {
    None => {
      return fail(&"codec: Age 付き直列化失敗");
    }
    Some(b_age) => {
      let dec = deserialize_cached_response(&b_age, 1007);
      match dec {
        None => {
          return fail(&"codec: Age 付き復元失敗");
        }
        Some(res_age) => {
          if header_of(&res_age, &"age") != "17" {
            return fail(&"codec: 更新された単一の Age 不一致 (期待 17)");
          }
        }
      }
    }
  }

  // 3072 バイト超の値は直列化で拒否（None）
  let mut big_body = Bytes.new();
  while big_body.byte_len() < 3100 {
    big_body.push(65);
  }
  let big_encoded = serialize_cached_response(200, &hs, &big_body, 1000, 0);
  if big_encoded.is_some() {
    return fail(&"codec: 3072 バイト超の直列化は拒否");
  }

  // 壊れたバイナリの復元は None
  let mut broken = Bytes.new();
  broken.push(0);
  broken.push(200);
  if deserialize_cached_response(&broken, 1000).is_some() {
    return fail(&"codec: 不正バイナリ復元は None");
  }

  return true;
}

pub fn run_cache_stash_protocol_tests() -> Bool
  intent "sigil-stash-kv プロトコル電文（GET/PUT）の組み立てと解釈テスト"
  requires none
  ensures none
  effects console
{
  let key = "cache:key:1".as_bytes();
  let get_frame = encode_stash_get(&key);
  // GET フレームは 4 (Length) + 1 (Ver=1) + 1 (Op=2) + 2 (key_len) + 11 (key) = 19 バイト
  if get_frame.byte_len() != 19 {
    return fail(&"stash_proto: GET フレーム長");
  }

  let val = "cached-data".as_bytes();
  let put_frame = encode_stash_put(&key, &val, 60);
  match put_frame {
    None => {
      return fail(&"stash_proto: PUT フレーム作成失敗");
    }
    Some(pf) => {
      // PUT フレームは 4 + 1(Ver=1) + 1(Op=3) + 2 + 11 + 2 + 11 + 1(ttl_tag=1) + 8(ttl_sec) = 41 バイト
      if pf.byte_len() != 41 {
        return fail(&"stash_proto: PUT フレーム長");
      }
    }
  }

  // P2: DELETE フレームは 4 (Length) + 1 (Ver=1) + 1 (Op=4) + 2 (key_len) + 11 (key) = 19 バイト
  let del_frame = encode_stash_delete(&key);
  if del_frame.byte_len() != 19 {
    return fail(&"stash_proto: DELETE フレーム長不一致 (期待 19)");
  }

  // 応答解釈: Success (0x01)
  let mut s_resp = Bytes.new();
  s_resp.push(1);  // version = 1
  s_resp.push(1);  // res_type = 1 (Success)
  match parse_stash_response(&s_resp) {
    Ok(v) => {
      if v.is_none() {
        return fail(&"stash_proto: Success 応答は Ok(Some)");
      }
    }
    Err(_) => {
      return fail(&"stash_proto: Success 応答解釈失敗");
    }
  }

  // 応答解釈: Value (0x02)
  let mut v_resp = Bytes.new();
  v_resp.push(1);  // version = 1
  v_resp.push(2);  // res_type = 2 (Value)
  v_resp.push(0);
  v_resp.push(5);
  v_resp.extend(&"hello".as_bytes());
  match parse_stash_response(&v_resp) {
    Ok(opt) => {
      match opt {
        Some(b) => {
          if b.to_string_utf8().unwrap_or("") != "hello" {
            return fail(&"stash_proto: Value 応答値不一致");
          }
        }
        None => {
          return fail(&"stash_proto: Value 応答で値がない");
        }
      }
    }
    Err(_) => {
      return fail(&"stash_proto: Value 応答解釈失敗");
    }
  }

  // 応答解釈: NotFound (0x03)
  let mut nf_resp = Bytes.new();
  nf_resp.push(1);  // version = 1
  nf_resp.push(3);  // res_type = 3 (NotFound)
  match parse_stash_response(&nf_resp) {
    Ok(v) => {
      if v.is_some() {
        return fail(&"stash_proto: NotFound 応答は値なし");
      }
    }
    Err(_) => {
      return fail(&"stash_proto: NotFound 応答解釈失敗");
    }
  }

  // 応答解釈: Error (0x04)
  let mut err_resp = Bytes.new();
  err_resp.push(1);  // version = 1
  err_resp.push(4);  // res_type = 4 (Error)
  err_resp.push(4);  // code 4 = Capacity
  err_resp.push(0);
  err_resp.push(3);
  err_resp.extend(&"cap".as_bytes());
  match parse_stash_response(&err_resp) {
    Ok(_) => {
      return fail(&"stash_proto: Error 応答が Ok になった");
    }
    Err(code) => {
      if code != 4 {
        return fail(&"stash_proto: Error コード不一致");
      }
    }
  }

  return true;
}

fn config_ok(json: &String) -> Bool
  intent "経路設定の JSON が解釈できたら true"
  requires none
  ensures none
  effects none
{
  return parse_settings(&json.as_bytes()).is_ok();
}

pub fn run_cache_routes_config_tests() -> Bool
  intent "経路設定における cache 設定の解釈テスト"
  requires none
  ensures none
  effects console
{
  // 正常なプロキシ経路 + キャッシュ設定
  let valid_json = "{\"routes\":[{\"prefix\":\"/api/\",\"type\":\"proxy\",\"backends\":[\"127.0.0.1:8001\"],\"cache\":{\"backend\":\"127.0.0.1:6379\",\"ttl_sec\":120}}]}";
  match parse_settings(&valid_json.as_bytes()) {
    Err(_) => {
      return fail(&"routes_cache: 正しい cache 設定が失敗");
    }
    Ok(s) => {
      match s.routes.get(0) {
        None => {
          return fail(&"routes_cache: 経路なし");
        }
        Some(r) => {
          match r.cache {
            None => {
              return fail(&"routes_cache: cache が None");
            }
            Some(c) => {
              if c.backend_host != "127.0.0.1" || c.backend_port != 6379 || c.ttl_sec != 120 {
                return fail(&"routes_cache: cache 設定値不一致");
              }
            }
          }
        }
      }
    }
  }

  // ttl_sec 省略時はデフォルト 60
  let default_ttl_json = "{\"routes\":[{\"prefix\":\"/api/\",\"type\":\"proxy\",\"backends\":[\"127.0.0.1:8001\"],\"cache\":{\"backend\":\"127.0.0.1:6379\"}}]}";
  match parse_settings(&default_ttl_json.as_bytes()) {
    Err(_) => {
      return fail(&"routes_cache: ttl_sec 省略の cache 設定が失敗");
    }
    Ok(s) => {
      match s.routes.get(0) {
        None => {
          return fail(&"routes_cache: 経路なし");
        }
        Some(r) => {
          match r.cache {
            None => {
              return fail(&"routes_cache: cache が None");
            }
            Some(c) => {
              if c.ttl_sec != 60 {
                return fail(&"routes_cache: ttl_sec デフォルト値不一致");
              }
            }
          }
        }
      }
    }
  }

  // 静的配信経路に cache を指定すると拒否
  let static_with_cache = "{\"routes\":[{\"prefix\":\"/\",\"type\":\"static\",\"root\":\"/var/www\",\"cache\":{\"backend\":\"127.0.0.1:6379\"}}]}";
  if config_ok(&static_with_cache) {
    return fail(&"routes_cache: 静的配信経路への cache は拒否");
  }

  // backend なしの cache は拒否
  let no_backend = "{\"routes\":[{\"prefix\":\"/api/\",\"type\":\"proxy\",\"backends\":[\"127.0.0.1:8001\"],\"cache\":{\"ttl_sec\":60}}]}";
  if config_ok(&no_backend) {
    return fail(&"routes_cache: backend なしの cache は拒否");
  }

  // 不正な IPv4/ポートの backend は拒否
  let bad_backend = "{\"routes\":[{\"prefix\":\"/api/\",\"type\":\"proxy\",\"backends\":[\"127.0.0.1:8001\"],\"cache\":{\"backend\":\"invalid_host:6379\"}}]}";
  if config_ok(&bad_backend) {
    return fail(&"routes_cache: 不正ホストの cache backend は拒否");
  }

  // 不正な ttl_sec (< 1 または > 86400) は拒否
  let zero_ttl = "{\"routes\":[{\"prefix\":\"/api/\",\"type\":\"proxy\",\"backends\":[\"127.0.0.1:8001\"],\"cache\":{\"backend\":\"127.0.0.1:6379\",\"ttl_sec\":0}}]}";
  if config_ok(&zero_ttl) {
    return fail(&"routes_cache: ttl_sec=0 は拒否");
  }

  let big_ttl = "{\"routes\":[{\"prefix\":\"/api/\",\"type\":\"proxy\",\"backends\":[\"127.0.0.1:8001\"],\"cache\":{\"backend\":\"127.0.0.1:6379\",\"ttl_sec\":100000}}]}";
  if config_ok(&big_ttl) {
    return fail(&"routes_cache: ttl_sec=100000 は拒否");
  }

  // 未知のキーは拒否
  let unknown_key = "{\"routes\":[{\"prefix\":\"/api/\",\"type\":\"proxy\",\"backends\":[\"127.0.0.1:8001\"],\"cache\":{\"backend\":\"127.0.0.1:6379\",\"foo\":1}}]}";
  if config_ok(&unknown_key) {
    return fail(&"routes_cache: 未知のキーは拒否");
  }

  return true;
}
